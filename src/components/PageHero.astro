---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section
  class="relative overflow-hidden border-b border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-950/40"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(16,185,129,0.14),transparent_60%)]"
  >
  </div>
  <div
    class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8"
  >
    {
      eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="mt-3 text-balance text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-white"
    >
      {title}
    </h1>
    <p
      class="mx-auto mt-4 max-w-2xl text-balance text-lg leading-relaxed text-slate-600 dark:text-slate-300"
    >
      {description}
    </p>
  </div>
</section>
