---
const year = new Date().getFullYear();
---

<footer
  class="border-t border-slate-200 bg-slate-50/70 dark:border-slate-800 dark:bg-slate-950"
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a
          href="/"
          class="flex items-center gap-2.5 font-semibold tracking-tight text-slate-900 dark:text-white"
          aria-label="ImageSqueeze home"
        >
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500 text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path d="M4 7V5a1 1 0 0 1 1-1h2"></path>
              <path d="M17 4h2a1 1 0 0 1 1 1v2"></path>
              <path d="M20 17v2a1 1 0 0 1-1 1h-2"></path>
              <path d="M7 20H5a1 1 0 0 1-1-1v-2"></path>
              <path d="M8 12h8"></path>
              <path d="m10 9-3 3 3 3"></path>
              <path d="m14 9 3 3-3 3"></path>
            </svg>
          </span>
          <span class="text-lg">
            Image<span class="text-emerald-600 dark:text-emerald-400">Squeeze</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Compress and convert images for free, right in your browser. Your
          files never leave your device — no uploads, no sign-up, no limits.
        </p>
        <p
          class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
            ></span>
          </span>
          100% client-side
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">
            Tool
          </h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href="/#compressor"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >Image compressor</a
              >
            </li>
            <li>
              <a
                href="/#how-it-works"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >How it works</a
              >
            </li>
            <li>
              <a
                href="/#faq"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >FAQ</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">
            Company
          </h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href="/about"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >About</a
              >
            </li>
            <li>
              <a
                href="/contact"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >Contact</a
              >
            </li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-slate-900 dark:text-white">
            Legal
          </h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href="/privacy-policy"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >Privacy Policy</a
              >
            </li>
            <li>
              <a
                href="/terms"
                class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400"
                >Terms of Use</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-400"
    >
      <p>© {year} ImageSqueeze. All rights reserved.</p>
      <p>Made with Astro &amp; Tailwind CSS.</p>
    </div>
  </div>
</footer>
