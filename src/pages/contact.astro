---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact ImageSqueeze — Feedback & Support"
  description="Get in touch with ImageSqueeze for questions, feedback, bug reports or feature requests about the free browser-based image compressor."
>
  <PageHero
    eyebrow="Contact"
    title="Get in touch"
    description="Questions, feedback or a feature request? We would love to hear from you."
  />

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-5">
        <!-- Contact Form -->
        <div class="lg:col-span-3 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900/60 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Send us a message</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">
            Have a suggestion, question, or need assistance? Fill out the form below.
          </p>

          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for contacting ImageSqueeze! Your message has been received.'); this.reset();">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Your Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition"
              />
            </div>

            <div>
              <label for="topic" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Topic</label>
              <select
                id="topic"
                name="topic"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition"
              >
                <option value="feedback">General Feedback</option>
                <option value="bug">Report a Compression Bug</option>
                <option value="feature">Request a Feature</option>
                <option value="partnership">Business & Inquiries</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Tell us what's on your mind..."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-none text-sm transition"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition shadow-sm shadow-emerald-600/30 cursor-pointer"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Support Info Sidebar -->
        <div class="lg:col-span-2 space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60 shadow-sm">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <h3 class="text-base font-semibold text-slate-900 dark:text-white">Email support</h3>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              We usually reply within 24–48 hours on business days.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 text-xs leading-relaxed text-slate-600 dark:border-slate-800 dark:bg-slate-900/40 dark:text-slate-300">
            <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Important note about your images</h3>
            <p>
              Please do not send image files in support emails. ImageSqueeze never uploads your files — all compression occurs locally inside your web browser. A description of the file format (PNG, JPG, or WebP) and size is enough.
            </p>
          </div>

          <div class="text-center">
            <a
              href="/#compressor"
              class="inline-flex items-center gap-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 px-5 py-2.5 text-xs font-semibold text-slate-700 dark:text-slate-200 transition"
            >
              &larr; Back to the compressor
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
