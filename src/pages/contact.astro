---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact ImageSqueeze — Feedback & Support"
  description="Get in touch with ImageSqueeze for questions, feedback, bug reports or feature requests about the free browser-based image compressor."
>
  <PageHero
    eyebrow="Contact"
    title="Get in touch"
    description="Questions, feedback or a feature request? We would love to hear from you."
  />

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2">
        <div
          class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60"
        >
          <div
            class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h2 class="mt-4 text-base font-semibold text-slate-900 dark:text-white">
            Email us
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            The best way to reach us for support, feedback or partnership
            questions.
          </p>
          <a
            href="mailto:hello@imagesqueeze.com"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 underline decoration-emerald-300 underline-offset-4 transition hover:text-emerald-500 dark:text-emerald-400"
          >
            hello@imagesqueeze.com
          </a>
        </div>

        <div
          class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60"
        >
          <div
            class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path
                d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"
              ></path>
            </svg>
          </div>
          <h2 class="mt-4 text-base font-semibold text-slate-900 dark:text-white">
            Response time
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            We usually reply within 1–2 business days. Include your browser and
            operating system if you are reporting a bug.
          </p>
        </div>
      </div>

      <div
        class="mt-8 rounded-2xl border border-slate-200 bg-slate-50/70 p-6 text-sm leading-relaxed text-slate-600 dark:border-slate-800 dark:bg-slate-900/40 dark:text-slate-300"
      >
        <p class="font-semibold text-slate-900 dark:text-white">
          A note about images
        </p>
        <p class="mt-2">
          Please do not email us image files. ImageSqueeze never needs them —
          all compression happens on your device. If you are reporting a
          problem with a specific image, a description of the format and size
          is enough.
        </p>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/#compressor"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-emerald-600/25 transition hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950"
        >
          Back to the compressor
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
