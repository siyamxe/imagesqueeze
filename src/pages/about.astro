---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const values = [
  {
    title: 'Privacy first',
    description:
      'Your images are yours. Everything runs in your browser, so there is no upload, no server-side copy and nothing to leak.',
    icon: 'shield',
  },
  {
    title: 'Fast and focused',
    description:
      'One job, done well. No pop-ups, no forced sign-ups and no waiting in a server queue.',
    icon: 'bolt',
  },
  {
    title: 'Free for everyone',
    description:
      'No watermarks, no daily limits and no paywall. A useful tool should be available to everyone.',
    icon: 'heart',
  },
];
---

<BaseLayout
  title="About ImageSqueeze — A Free, Private Image Compressor"
  description="Learn why ImageSqueeze exists: a free, fast and private image compressor that runs entirely in your browser, with no uploads and no accounts."
>
  <PageHero
    eyebrow="About"
    title="A tiny tool with a simple mission"
    description="ImageSqueeze exists to make image compression fast, free and private — without uploads, accounts or hidden limits."
  />

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="legal-prose">
        <p class="!mt-0 !text-base">
          Most online image compressors work the same way: you upload your
          files to someone else’s server, wait for them to be processed, and
          hope they are deleted afterwards. For holiday photos, client work or
          anything private, that is a lot to ask.
        </p>
        <p>
          ImageSqueeze takes a different approach. The entire compressor runs
          inside your browser. Your images are decoded, resized, compressed and
          encoded on your own device. Nothing is sent over the network, so
          there is no upload to wait for and no copy to worry about.
        </p>
        <p>
          The tool is intentionally small and focused. It does not try to be a
          photo editor or a cloud drive. It compresses and converts images,
          tells you exactly how much space you saved, and lets you download the
          results — individually or as a ZIP.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {
          values.map((value) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900/60">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">
                {value.icon === 'shield' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z" />
                  </svg>
                )}
                {value.icon === 'bolt' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                    <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14Z" />
                  </svg>
                )}
                {value.icon === 'heart' && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                  </svg>
                )}
              </div>
              <h2 class="mt-4 text-base font-semibold text-slate-900 dark:text-white">
                {value.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>

      <div
        class="mt-12 rounded-2xl border border-emerald-200 bg-emerald-50/70 p-6 dark:border-emerald-500/20 dark:bg-emerald-500/5"
      >
        <h2 class="text-base font-semibold text-slate-900 dark:text-white">
          How it works under the hood
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          The browser’s Canvas API handles decoding, resizing and encoding, and
          Web Workers keep the interface responsive while large images are
          processed. The only thing stored on your device is your dark-mode
          preference. There is no backend, no database and no tracking.
        </p>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/#compressor"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-emerald-600/25 transition hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-950"
        >
          Try the compressor
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
